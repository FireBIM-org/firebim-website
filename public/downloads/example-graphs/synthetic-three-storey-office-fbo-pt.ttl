ex:second-storey a fbo:BuildingStorey;
    rdfs:label "Second storey"@en;
    fbo:hasSubitem ex:s-corridor, ex:s-stair, ex:s-lift, ex:s-toilet, ex:s-printer, ex:s-canteen, ex:s-kitchen, ex:s-boardroom, ex:s-storage.
