ex:ground-storey a fbo:BuildingStorey;
    rdfs:label "Ground storey"@en;
    fbo:hasSubitem ex:g-corridor, ex:g-stair, ex:g-lift, ex:g-toilet, ex:g-printer, ex:g-reception, ex:g-open-office, ex:g-meeting.
ex:first-storey a fbo:BuildingStorey;
