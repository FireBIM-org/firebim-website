# SYNTHETIC TEST GRAPH — NOT A REAL BUILDING.
# Three-storey office with 25 rooms, using generic FBO and FBO-PT.

@prefix ex: <https://firebim.org/test-data/pt/three-storey-office/>.
@prefix fbo: <https://firebim.org/ontologies/fbo#>.
@prefix fbo-pt: <https://firebim.org/ontologies/fbo/pt#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

ex:office-building a fbo:Building;
    rdfs:label "FireBIM Harbour Office"@en;
    fbo:hasSubitem ex:ground-storey, ex:first-storey, ex:second-storey.
ex:project-new-office rdfs:label "New office construction"@en.
ex:passive-protection-package rdfs:label "Compartmentation and protected egress package"@en.
ex:alarm-system a fbo:AutomaticFireAlarmsystem;
