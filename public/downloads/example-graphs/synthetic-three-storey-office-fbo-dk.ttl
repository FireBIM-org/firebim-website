@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

ex:office-building a fbo:Building;
    rdfs:label "FireBIM Harbour Office"@en;
    fbo:hasSubitem ex:ground-storey, ex:first-storey, ex:second-storey.
ex:project-new-office rdfs:label "New office construction"@en.
ex:passive-protection-package rdfs:label "Compartmentation and protected egress package"@en.
